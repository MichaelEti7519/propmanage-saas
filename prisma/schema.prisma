generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  landlord
  tenant
  admin
}

enum UnitStatus {
  vacant
  occupied
  maintenance
}

enum PaymentStatus {
  paid
  pending
  overdue
}

enum MaintenanceStatus {
  open
  in_progress
  closed
}

enum MaintenancePriority {
  Low
  Medium
  High
}

enum ReportTargetType {
  landlord
  tenant
  property
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum VerificationStatus {
  not_started
  pending
  verified
  rejected
  needs_review
}

enum ViewingRequestStatus {
  pending
  approved
  declined
  cancelled
}

model User {
  id            String            @id @default(cuid())
  firstName     String
  lastName      String
  email         String            @unique
  passwordHash  String
  role          UserRole
  phone         String?
  avatarUrl     String?
  emailVerificationStatus VerificationStatus @default(pending)
  phoneVerificationStatus VerificationStatus @default(not_started)
  identityVerificationStatus VerificationStatus @default(not_started)
  propertyAuthorizationStatus VerificationStatus @default(not_started)
  businessRegistrationStatus VerificationStatus @default(not_started)
  incomeVerificationStatus VerificationStatus @default(not_started)
  payoutVerificationStatus VerificationStatus @default(not_started)
  trustScore    Int               @default(100)
  blacklisted   Boolean           @default(false)
  properties    Property[]        @relation("UserProperties")
  landlordTenants Tenant[]        @relation("LandlordTenants")
  accountTenants Tenant[]        @relation("AccountTenants")
  viewingRequests ViewingRequest[]
  documents     Document[]
  invitations   TenantInvitation[] @relation("InvitationLandlord")
  reportsFiled  Report[]          @relation("ReportReporter")
  reportsReviewed Report[]        @relation("ReportReviewer")
  messagesSent  Message[]         @relation("MessageSender")
  messagesReceived Message[]      @relation("MessageRecipient")
  auditEntries  AuditLog[]        @relation("AuditActor")
  verificationReviews VerificationReview[] @relation("UserVerificationReviews")
  verificationDecisions VerificationReview[] @relation("VerificationReviewsGiven")
  /// Second factor. The secret is only written while setup is in progress; enabling requires a
  /// valid code, and recovery codes are stored as SHA-256 hashes, never in the clear.
    totpSecret            String?
    totpEnabledAt         DateTime?
    recoveryCodes         String[]                      @default([])
    refreshTokens         RefreshToken[]                @relation("UserRefreshTokens")
    passwordResets        PasswordResetToken[]          @relation("UserPasswordResets")
    emailVerifications    EmailVerificationToken[]      @relation("UserEmailVerifications")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Report {
  id                String           @id @default(cuid())
  reporterId        String
  reporter          User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reporterRole      UserRole
  targetType        ReportTargetType
  targetId          String
  targetName        String?
  propertyId        String?
  listingId         String?
  transactionId     String?
  tenantRef         String?
  reason            String
  message           String
  riskBand          String           @default("medium")
  escalateForReview Boolean          @default(true)
  status            ReportStatus     @default(open)
  resolutionNote    String?
  reviewedById      String?
  reviewedBy        User?            @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  reason    String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Property {
  id                String              @id @default(cuid())
  landlordId        String
  landlord          User                @relation("UserProperties", fields: [landlordId], references: [id], onDelete: Cascade)
  name              String
  address           String
  city              String
  state             String
  units             Int                 @default(0)
  occupancy         Int                 @default(0)
  status            String              @default("Active")
  manager           String              @default("")
  unitsList         Unit[]
  maintenanceRequests MaintenanceRequest[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Unit {
  id                String              @id @default(cuid())
  propertyId        String
  property          Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  number            String
  floor             Int
  bedrooms          Int
  bathrooms         Int
  rent              Int
  status            UnitStatus          @default(vacant)
  isListed          Boolean             @default(false)
  listingDescription String?
  tenantId          String?
  payments          Payment[]
  maintenanceRequests MaintenanceRequest[]
  viewingRequests   ViewingRequest[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([propertyId, number])
}

model ViewingRequest {
  id        String               @id @default(cuid())
  tenantId  String
  tenant    User                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  status    ViewingRequestStatus @default(pending)
  message   String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([unitId, status, createdAt])
}

model Tenant {
  id                String              @id @default(cuid())
  landlordId        String?
  landlord          User?               @relation("LandlordTenants", fields: [landlordId], references: [id])
  userId            String?
  user              User?               @relation("AccountTenants", fields: [userId], references: [id])
  firstName         String
  lastName          String
  email             String             @unique
  phone             String?
  unitId            String?
  status            String             @default("Applicant")
  leaseStart        DateTime?
  leaseEnd          DateTime?
  rent              Int                @default(0)
  payments          Payment[]
  maintenanceRequests MaintenanceRequest[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model TenantInvitation {
  id          String    @id @default(cuid())
  landlordId  String
  landlord    User      @relation("InvitationLandlord", fields: [landlordId], references: [id], onDelete: Cascade)
  email       String
  firstName   String
  lastName    String
  phone       String?
  unitId      String
  leaseStart  DateTime?
  leaseEnd    DateTime?
  tokenHash   String    @unique
  expiresAt   DateTime
  accepted    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  amount    Int
  dueDate   DateTime
  paidDate  DateTime?
  status    PaymentStatus @default(pending)
  method    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model MaintenanceRequest {
  id          String               @id @default(cuid())
  propertyId  String
  property    Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      MaintenanceStatus    @default(open)
  priority    MaintenancePriority  @default(Medium)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  subject     String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([recipientId, read, createdAt])
  @@index([senderId, createdAt])
}

model Document {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  type      String
  date      DateTime
  size      String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
}

/// Records who did what to whom inside the admin area. Entries deliberately keep only the
/// identifiers and the decision, never the report or enquiry text, so the log itself cannot
/// become a second copy of user-submitted personal data.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  actorRole  UserRole
  action     String
  targetType String
  targetId   String?
  summary    String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

/// Rotation-based session record. Only the SHA-256 hash of a refresh token is stored, so a database
/// read cannot mint a session. Reusing a rotated token revokes the whole family for that user.
model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  accessJti     String?   @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Shared fixed-window counters used by all application instances for API rate limits.
model RateLimitCounter {
  key       String   @id
  totalHits Int
  resetAt   DateTime

  @@index([resetAt])
}

/// Minimal durable Resend delivery history. Never store recipient addresses or message content.
model EmailDeliveryEvent {
  providerEventId String   @id
  emailId         String?
  eventType       String
  occurredAt      DateTime
  receivedAt      DateTime @default(now())

  @@index([occurredAt])
  @@index([emailId, occurredAt])
  @@index([eventType, occurredAt])
}

/// Time-boxed, single-use password reset request. The token itself only ever exists in the link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserPasswordResets", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Single-use email ownership proof. Confirming one writes a VerificationReview row, so the
/// verified badge still has a named reviewer and a stated basis.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserEmailVerifications", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// One row per recorded verification decision. A "verified" badge is only credible because a row
/// here names the reviewer and the basis for the decision, so a status cannot be flipped without
/// an accountable person and a described check.
model VerificationReview {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation("UserVerificationReviews", fields: [userId], references: [id], onDelete: Cascade)
  field      String
  fromStatus VerificationStatus
  toStatus   VerificationStatus
  basis      String
  reviewerId String
  reviewer   User               @relation("VerificationReviewsGiven", fields: [reviewerId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([reviewerId, createdAt])
}
